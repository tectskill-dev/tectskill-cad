<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses</title>
<style>
  body { font-family: "Segoe UI", Tahoma, Arial, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { font-size: 1.6rem; } h2 { margin-top: 2rem; } h3 { margin-top: 2.5rem; border-top: 1px solid #ddd; padding-top: 1rem; }
  pre { white-space: pre-wrap; background: #f6f6f6; padding: 1rem; font-size: .8rem; border-radius: 6px; }
  ul.used { columns: 3; font-size: .85rem; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>This program includes the following open-source software. Each license text and the packages that use it are listed below.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul class="used">
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
